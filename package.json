{
  "name": "harika-clickdummy",
  "version": "0.3.0",
  "private": true,
  "description": "HTML-first UIkit Harika Intelligence Center clickdummy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "verify": "npm run check && npm run build && npm run build:pages",
    "transfer:status": "node scripts/transfer-status.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "uikit": "3.25.25"
  },
  "devDependencies": {
    "less": "4.9.1",
    "vite": "8.3.3"
  }
}
