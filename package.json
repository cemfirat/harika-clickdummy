{
  "name": "harika-clickdummy",
  "version": "0.4.0",
  "private": true,
  "description": "HTML-first UIkit Harika clickdummy with standard, interface and customer themes.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode interface",
    "dev:standard": "vite --mode standard",
    "dev:customer:ambra": "vite --mode customer-ambra",
    "check": "node scripts/check.mjs",
    "build": "vite build --mode interface",
    "build:standard": "vite build --mode standard",
    "build:customer:ambra": "vite build --mode customer-ambra",
    "build:pages": "vite build --mode pages",
    "verify": "npm run check && npm run build:standard && npm run build && npm run build:customer:ambra && npm run build:pages",
    "transfer:status": "node scripts/transfer-status.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "uikit": "3.25.25"
  },
  "devDependencies": {
    "less": "4.9.1",
    "vite": "8.3.3"
  }
}
